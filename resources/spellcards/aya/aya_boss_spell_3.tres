[gd_resource type="Resource" script_class="SpellcardData" format=3]

[ext_resource type="Script" path="res://scripts/resources/spellcard_data.gd" id="1_spell_script"]
[ext_resource type="Script" path="res://scripts/resources/danmaku_random_spray_step.gd" id="2_spray_script"]
[ext_resource type="Script" path="res://scripts/resources/danmaku_step.gd" id="3_step_script"]
[ext_resource type="Script" path="res://scripts/resources/danmaku_delay_step.gd" id="4_delay_script"]
[ext_resource type="Resource" path="res://resources/bullets/red_pellet.tres" id="5_pellet"]
[ext_resource type="Resource" path="res://resources/bullets/red_ring_ball.tres" id="6_ring"]

[sub_resource type="Resource" id="Resource_spray"]
script = ExtResource("2_spray_script")
bullet_data = ExtResource("5_pellet")
second_bullet_data = ExtResource("6_ring")

[sub_resource type="Resource" id="Resource_hold"]
script = ExtResource("4_delay_script")
delay_seconds = 1.0

[resource]
script = ExtResource("1_spell_script")
spellcard_id = "aya_boss_spell_3"
spellcard_name = "Scattered Wind"
level = 4
waves_min = 1
waves_max = 1
wave_interval = 0.0
jitter_wave_origin = false
steps = Array[ExtResource("3_step_script")]([SubResource("Resource_spray"), SubResource("Resource_hold")])
