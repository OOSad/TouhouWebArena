[gd_resource type="Resource" script_class="SpellcardData" format=3]

[ext_resource type="Script" path="res://scripts/resources/spellcard_data.gd" id="1_spell_script"]
[ext_resource type="Script" path="res://scripts/resources/danmaku_marching_column_step.gd" id="2_column_script"]
[ext_resource type="Script" path="res://scripts/resources/danmaku_step.gd" id="3_step_base"]
[ext_resource type="Resource" path="res://resources/bullets/red_pellet.tres" id="4_pellet"]
[ext_resource type="Resource" path="res://resources/bullets/red_arrow.tres" id="5_arrow"]

[sub_resource type="Resource" id="Resource_columns"]
script = ExtResource("2_column_script")
bullet_data = ExtResource("4_pellet")
alternate_bullet_data = ExtResource("5_arrow")
mirrored = true
layers = 8
interval_frames = 10

[resource]
script = ExtResource("1_spell_script")
spellcard_id = "aya_lv2"
spellcard_name = "Wind Sign \"Wind God's Favor\""
level = 2
waves_min = 1
waves_max = 1
jitter_wave_origin = false
steps = Array[ExtResource("3_step_base")]([SubResource("Resource_columns")])
